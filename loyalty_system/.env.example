# --- Django ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# --- Database (docker-compose service names) ---
DATABASE_URL=postgres://loyalty:loyalty@db:5432/loyalty

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- LINE OA / LINE Login ---
# Messaging API channel (สำหรับ push message / webhook)
LINE_CHANNEL_ID=your-messaging-api-channel-id
LINE_CHANNEL_SECRET=your-messaging-api-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-messaging-api-channel-access-token

# LIFF app id (สร้างจาก LINE Developers Console ผูกกับ Channel เดียวกัน)
LIFF_ID=1234567890-abcdefgh

# --- Loyalty defaults (แก้ไขได้ภายหลังผ่านหน้า Settings ในระบบ) ---
DEFAULT_BAHT_PER_POINT=50
DEFAULT_POINT_EXPIRY_DAYS=365
EXPIRY_WARNING_DAYS=7
