# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-api-domain.com,127.0.0.1,localhost

# --- Database (Postgres) ---
# Full connection URL, e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://line_member_user:password@localhost:5432/line_members

# --- CORS ---
# Comma-separated list of the exact origins your LIFF frontend is served from.
CORS_ALLOWED_ORIGINS=https://your-liff-app.vercel.app

# --- LINE Login / LIFF ---
# Channel ID of the LINE Login channel your LIFF app belongs to.
# Used to validate the "aud" claim of every ID token we verify.
LINE_LOGIN_CHANNEL_ID=1234567890

# --- LINE Messaging API (Official Account) ---
# Long-lived channel access token for the OA, used to push the Flex
# Message member card after a successful registration. Optional: if
# left blank, the push step is skipped and only the API response is used.
LINE_CHANNEL_ACCESS_TOKEN=

# --- LIFF ---
# Used only for building the "add to home screen"/share links in the flex message.
LIFF_ID=1234567890-abcdefgh
