DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# ค่าเหล่านี้ต้องตรงกับ service "db" ใน docker-compose.yml
POSTGRES_DB=loyalty_db
POSTGRES_USER=loyalty
POSTGRES_PASSWORD=loyalty
DATABASE_URL=postgres://loyalty:loyalty@db:5432/loyalty_db

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# LINE Official Account (Messaging API) - จาก LINE Developers Console
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LIFF app (สร้างใน LINE Developers Console > LIFF tab ผูกกับ Channel เดียวกัน)
LIFF_ID=1234567890-abcdefgh
LIFF_CHANNEL_ID=1234567890
LIFF_BASE_URL=https://liff.line.me

# กติกาสะสมแต้ม
BAHT_PER_POINT=50
POINT_EXPIRY_DAYS=365
EXPIRY_WARNING_DAYS=30
